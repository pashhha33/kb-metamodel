# Зависимости сборки артефактов (нужны только для конвейера, плагин работает офлайн)
node_modules/

# Служебные файлы ОС и редакторов
.DS_Store
Thumbs.db
*.swp
*~

# Журналы и временные файлы конвейера
npm-debug.log*
tools/**/*.log
*.tmp

# Obsidian: служебная область плагина появится в фазе 5
.sb/

# Производные артефакты (schema/dist/**, src/generated/**, tools/fixtures/**)
# СОЗНАТЕЛЬНО КОММИТЯТСЯ: они являются частью выпуска версии метамодели и входят
# в состав артефакта плагина. Проверка свежести — `npm run schema:all` (скрипт
# пересобирает их детерминированно; расхождение означает, что источник изменён).
